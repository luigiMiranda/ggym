<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme: holds the window until theme preferences are read (M0 step 8). -->
    <style name="Theme.GGym" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GGym.Main</item>
    </style>

    <!-- Compose draws everything; this only covers the pre-Compose frame. -->
    <style name="Theme.GGym.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
