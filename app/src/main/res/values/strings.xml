    <!--
      Rest timer: the notification the countdown lives in, and the two channels it can arrive on.
      The running one is a silent chronometer; the finished one vibrates, and the tone itself is
      played by the app (`AndroidRestAlertPlayer`) so that it can duck the user's music instead of
      being mixed over it by the system.
    -->
    <string name="rest_notification_text">Resting</string>
