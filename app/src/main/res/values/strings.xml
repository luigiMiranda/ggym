    <!--
      Durations. The clock itself (`mm:ss`, `h:mm:ss`) is built in `DurationFormat`, which needs no
      copy; these are the summary phrases it composes. `%2$02d` keeps the minutes two digits, so
      "1 h 05 min" does not read as five minutes.
    -->
    <string name="duration_minutes">%1$d min</string>
    <string name="duration_hours_minutes">%1$d h %2$02d min</string>

