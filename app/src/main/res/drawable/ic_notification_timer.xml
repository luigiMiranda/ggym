<?xml version="1.0" encoding="utf-8"?>
<!--
  The timer's status-bar icon: a stopwatch, not the app's brand mark, because at 24dp the mark's
  padding would leave it unreadable. Same source of truth as the launcher icon (artwork/ggym.svg)
  for the palette; drawn here as the flat monochrome silhouette notifications require.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The crown, and the stem that joins it to the ring. -->
    <path
        android:pathData="M10.4,4.4 L13.6,4.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M12,4.4 L12,7.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />

    <!-- The ring, and the two hands. -->
    <path
        android:pathData="M12,7.6 A5.8,5.8 0 1 0 12,19.2 A5.8,5.8 0 1 0 12,7.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M12,10.6 L12,13.4 L14.1,14.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />
</vector>
