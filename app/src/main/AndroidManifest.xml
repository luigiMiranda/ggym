<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 100% offline: no permissions are declared anywhere in this app. -->
    <!--
      allowBackup=false covers API <= 30; dataExtractionRules covers API 31+ (Auto Backup and
      device transfer both excluded). Lint flags the pair as redundant, but deliberately keeping
      both is what makes "no cloud, ever" true across the whole supported range.
    -->
    <application
        android:name=".GgymApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GGym">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GGym"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
