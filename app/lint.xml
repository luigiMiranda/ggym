<?xml version="1.0" encoding="utf-8"?>
<!--
  Three intentional patterns that lint cannot model, suppressed here (with reasons) rather than
  left as permanent noise in every build log.
-->
<lint>
    <!--
      aapt2 only compiles <adaptive-icon> XML when it carries a version qualifier, so the
      conventional `mipmap-anydpi-v26` layout is required even though minSdk is already 26.
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!--
      allowBackup=false disables backup/D2D transfer on API 26-30 and dataExtractionRules does
      the same on API 31+. Lint wants fullBackupContent as well, which would be a second,
      redundant mechanism for the same "data never leaves the device" guarantee.
    -->
    <issue id="DataExtractionRules" severity="ignore" />

    <!--
      Dependency currency is a reviewed decision, not a build property: material3 is pinned to
      1.5.0-beta01 on purpose, KSP is standalone, and the versions in `libs.versions.toml` were
      chosen against AGP 9. The detector decides "newer" by querying Maven over the network, so a
      connected build warns and an offline one does not — a gate that changes with connectivity is
      not a gate. A version moves when a decision-log row moves it.
    -->
    <issue id="NewerVersionAvailable" severity="ignore" />
</lint>
